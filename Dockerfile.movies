FROM node:22-alpine AS player-assets
RUN mkdir /assets && cd /assets && npm pack movi-player@0.4.1 --quiet \
    && tar -xzf movi-player-0.4.1.tgz --strip-components=2 package/dist/element.js package/dist/movi.wasm \
    && rm movi-player-0.4.1.tgz \
    && gzip -k element.js movi.wasm

FROM rust:1.90-bookworm AS build
WORKDIR /src
COPY resolver ./resolver
COPY app/movies.html app/movies-login.html app/movies.css app/movies.js ./app/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/resolver/target \
    cargo build --locked --release --manifest-path resolver/Cargo.toml \
    && cp resolver/target/release/movi-movie-resolver /movi-movie-resolver

FROM debian:bookworm-slim
RUN useradd --system --uid 10001 --no-create-home resolver
WORKDIR /srv
COPY --from=build /movi-movie-resolver /usr/local/bin/movi-movie-resolver
COPY --from=player-assets /assets ./dist
USER resolver
EXPOSE 8766
CMD ["/usr/local/bin/movi-movie-resolver"]
